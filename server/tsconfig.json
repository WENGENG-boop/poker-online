{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../src/game/**/*.ts", "../src/net/roomServer.ts", "../src/net/protocol.ts", "../src/net/moderation.ts", "../src/net/inviteCode.ts", "../src/net/adminHistory.ts"],
  "exclude": ["../src/**/*.test.ts"]
}
